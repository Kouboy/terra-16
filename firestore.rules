rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedStringArray(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 200));
    }

    function isValidHeadgearEnum(val) {
      return val is string && val.size() >= 1 && val.size() <= 32
        && val in ['tricorne_fauve', 'beret_chroniqueur', 'casque_mineur', 'capuche_sylvestre', 'couronne_menhir', 'lunettes_astro', 'monocle_erudit', 'tricorne_reliquaire', 'couronne_saisons', 'couronne_chroniqueur', 'bandeau_guilde_unie'];
    }

    function isValidOutfitEnum(val) {
      return val is string && val.size() >= 1 && val.size() <= 32
        && val in ['arpenteur', 'chroniqueur', 'geomancien', 'sylvestre', 'ombres', 'barde', 'almanach_solaire', 'chasseur_reliques', 'conteuse_legende'];
    }

    function isValidToolEnum(val) {
      return val is string && val.size() >= 1 && val.size() <= 32
        && val in ['lanterne_laiton', 'boussole_astrale', 'marteau_geologue', 'plume_enluminee', 'fiole_spectrale', 'loupe_sceau_or', 'clef_coffres_anciens', 'sablier_ephemeride', 'plume_trois_actes'];
    }

    function isValidPackEnum(val) {
      return val is string && val.size() >= 1 && val.size() <= 32
        && val in ['besace_cuir', 'rouleau_cartes', 'hotte_cristaux', 'ailerons_automate', 'coffret_piste', 'grimoire_almanach', 'astrolabe_dorsal'];
    }

    function isValidFamiliarEnum(val) {
      return val is string && val.size() >= 1 && val.size() <= 32
        && val in ['aucun', 'chouette_erudite', 'goupil_saisons', 'scarabee_boussole', 'salamandre_cristal', 'corbeau_cartographe', 'feu_follet_astral', 'hermine_royale', 'cerf_brumes', 'loutre_riviere'];
    }

    function isValidPinnedTrophyEnum(val) {
      return val is string && val.size() <= 40
        && val in ['', 'oiseau_de_nuit', 'marcheur_orage', 'speleologue', 'arpenteur_10km', 'grand_randonneur_50km', 'maitre_7_roches', 'chasseur_geodesique', 'gardien_petit_patrimoine', 'ouvreur_reliques', 'leveur_brumes', 'naturaliste_complet', 'champion_contrats', 'tisserand_recits', 'maitre_chroniques', 'heraut_communaute', 'temoin_phenomenes', 'champion_pantheon'];
    }

    // Validation Blueprint: ExplorerProfile (synced verbatim with firebase-blueprint.json)
    function isValidExplorerProfile(data) {
      return data.keys().hasAll([
          'ownerId',
          'displayName',
          'totalXp',
          'xpHistoire',
          'xpGeographie',
          'xpEcosysteme',
          'xpEtrange',
          'discoveriesCount',
          'completedMissions',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'displayName',
          'totalXp',
          'xpHistoire',
          'xpGeographie',
          'xpEcosysteme',
          'xpEtrange',
          'xpLegende',
          'gender',
          'avatarPreset',
          'skinTone',
          'headgearId',
          'outfitId',
          'toolId',
          'packId',
          'familiarId',
          'pinnedTrophyId',
          'walkedMeters',
          'nightFeatsCount',
          'stormFeatsCount',
          'completedContractsCount',
          'solvedRiddlesCount',
          'completedHuntsCount',
          'claimedAlmanacCount',
          'completedNarrativesCount',
          'claimedCommunityChallengesCount',
          'claimedLiveEventsCount',
          'discoveriesCount',
          'completedMissions',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.totalXp is number && data.totalXp >= 0 && data.totalXp <= 10000000
        && data.xpHistoire is number && data.xpHistoire >= 0 && data.xpHistoire <= 10000000
        && data.xpGeographie is number && data.xpGeographie >= 0 && data.xpGeographie <= 10000000
        && data.xpEcosysteme is number && data.xpEcosysteme >= 0 && data.xpEcosysteme <= 10000000
        && data.xpEtrange is number && data.xpEtrange >= 0 && data.xpEtrange <= 10000000
        && (!('xpLegende' in data) || (data.xpLegende is number && data.xpLegende >= 0 && data.xpLegende <= 10000000))
        && (!('gender' in data) || (data.gender is string && data.gender.size() >= 1 && data.gender.size() <= 16 && data.gender in ['feminin', 'masculin', 'neutre']))
        && (!('avatarPreset' in data) || (data.avatarPreset is string && data.avatarPreset.size() >= 1 && data.avatarPreset.size() <= 32 && data.avatarPreset in ['cartographe', 'eclaireur', 'archiviste', 'forgeron', 'oracle', 'botaniste']))
        && (!('skinTone' in data) || (data.skinTone is string && data.skinTone.size() >= 1 && data.skinTone.size() <= 32 && data.skinTone in ['clair', 'hale', 'ambre', 'ebene', 'porcelaine']))
        && (!('headgearId' in data) || isValidHeadgearEnum(data.headgearId))
        && (!('outfitId' in data) || isValidOutfitEnum(data.outfitId))
        && (!('toolId' in data) || isValidToolEnum(data.toolId))
        && (!('packId' in data) || isValidPackEnum(data.packId))
        && (!('familiarId' in data) || isValidFamiliarEnum(data.familiarId))
        && (!('pinnedTrophyId' in data) || isValidPinnedTrophyEnum(data.pinnedTrophyId))
        && (!('walkedMeters' in data) || (data.walkedMeters is number && data.walkedMeters >= 0 && data.walkedMeters <= 100000000))
        && (!('nightFeatsCount' in data) || (data.nightFeatsCount is number && data.nightFeatsCount >= 0 && data.nightFeatsCount <= 100000))
        && (!('stormFeatsCount' in data) || (data.stormFeatsCount is number && data.stormFeatsCount >= 0 && data.stormFeatsCount <= 100000))
        && (!('completedContractsCount' in data) || (data.completedContractsCount is number && data.completedContractsCount >= 0 && data.completedContractsCount <= 100000))
        && (!('solvedRiddlesCount' in data) || (data.solvedRiddlesCount is number && data.solvedRiddlesCount >= 0 && data.solvedRiddlesCount <= 100000))
        && (!('completedHuntsCount' in data) || (data.completedHuntsCount is number && data.completedHuntsCount >= 0 && data.completedHuntsCount <= 100000))
        && (!('claimedAlmanacCount' in data) || (data.claimedAlmanacCount is number && data.claimedAlmanacCount >= 0 && data.claimedAlmanacCount <= 100000))
        && (!('completedNarrativesCount' in data) || (data.completedNarrativesCount is number && data.completedNarrativesCount >= 0 && data.completedNarrativesCount <= 100000))
        && (!('claimedCommunityChallengesCount' in data) || (data.claimedCommunityChallengesCount is number && data.claimedCommunityChallengesCount >= 0 && data.claimedCommunityChallengesCount <= 100000))
        && (!('claimedLiveEventsCount' in data) || (data.claimedLiveEventsCount is number && data.claimedLiveEventsCount >= 0 && data.claimedLiveEventsCount <= 100000))
        && data.discoveriesCount is number && data.discoveriesCount >= 0 && data.discoveriesCount <= 100000
        && isBoundedStringArray(data.completedMissions, 50)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: JournalDiscovery (synced verbatim with firebase-blueprint.json)
    function isValidJournalDiscovery(data) {
      return data.keys().hasAll([
          'ownerId',
          'poiId',
          'name',
          'category',
          'subType',
          'source',
          'lat',
          'lng',
          'summary',
          'nearWaterway',
          'waterwayName',
          'safetyNotice',
          'externalUrl',
          'xpAwarded',
          'relatedPoiIds',
          'relatedPoiTitles',
          'personalNote',
          'photoCount',
          'discoveredAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'poiId',
          'name',
          'category',
          'subType',
          'eraLabel',
          'source',
          'lat',
          'lng',
          'summary',
          'nearWaterway',
          'waterwayName',
          'safetyNotice',
          'externalUrl',
          'xpAwarded',
          'relatedPoiIds',
          'relatedPoiTitles',
          'personalNote',
          'photoCount',
          'discoveredAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.poiId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 32
        && data.category in ['histoire', 'geographie', 'ecosysteme', 'etrange', 'legende']
        && data.subType is string && data.subType.size() >= 1 && data.subType.size() <= 80
        && (!('eraLabel' in data) || (data.eraLabel is string && data.eraLabel.size() <= 100))
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 80
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 2500
        && data.nearWaterway is bool
        && data.waterwayName is string && data.waterwayName.size() <= 120
        && data.safetyNotice is string && data.safetyNotice.size() <= 400
        && data.externalUrl is string && data.externalUrl.size() <= 500
        && data.xpAwarded is number && data.xpAwarded >= 0 && data.xpAwarded <= 5000
        && isBoundedStringArray(data.relatedPoiIds, 10)
        && isBoundedStringArray(data.relatedPoiTitles, 10)
        && data.personalNote is string && data.personalNote.size() <= 2000
        && data.photoCount is number && data.photoCount >= 0 && data.photoCount <= 20
        && data.discoveredAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ExplorerCairn (synced verbatim with firebase-blueprint.json)
    function isValidExplorerCairn(data) {
      return data.keys().hasAll([
          'authorId',
          'authorCallsign',
          'poiId',
          'poiName',
          'tag',
          'message',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId',
          'authorCallsign',
          'authorGender',
          'authorAvatarPreset',
          'authorSkinTone',
          'authorHeadgearId',
          'authorOutfitId',
          'poiId',
          'poiName',
          'tag',
          'message',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.authorId)
        && data.authorId == request.auth.uid
        && data.authorCallsign is string && data.authorCallsign.size() >= 1 && data.authorCallsign.size() <= 60
        && (!('authorGender' in data) || (data.authorGender is string && data.authorGender.size() >= 1 && data.authorGender.size() <= 16 && data.authorGender in ['feminin', 'masculin', 'neutre']))
        && (!('authorAvatarPreset' in data) || (data.authorAvatarPreset is string && data.authorAvatarPreset.size() >= 1 && data.authorAvatarPreset.size() <= 32 && data.authorAvatarPreset in ['cartographe', 'eclaireur', 'archiviste', 'forgeron', 'oracle', 'botaniste']))
        && (!('authorSkinTone' in data) || (data.authorSkinTone is string && data.authorSkinTone.size() >= 1 && data.authorSkinTone.size() <= 32 && data.authorSkinTone in ['clair', 'hale', 'ambre', 'ebene', 'porcelaine']))
        && (!('authorHeadgearId' in data) || isValidHeadgearEnum(data.authorHeadgearId))
        && (!('authorOutfitId' in data) || isValidOutfitEnum(data.authorOutfitId))
        && isValidId(data.poiId)
        && data.poiName is string && data.poiName.size() >= 1 && data.poiName.size() <= 200
        && data.tag is string && data.tag.size() >= 1 && data.tag.size() <= 32 && data.tag in ['architecture', 'acces', 'point_de_vue', 'conseil_heure', 'secret']
        && data.message is string && data.message.size() >= 3 && data.message.size() <= 280
        && data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ExplorerSpecimen (synced verbatim with firebase-blueprint.json)
    function isValidExplorerSpecimen(data) {
      return data.keys().hasAll([
          'ownerId',
          'specimenId',
          'domain',
          'affinity',
          'name',
          'latinOrMineralName',
          'familyLabel',
          'lithologyLabel',
          'bedrockPeriod',
          'bedrockAgeMa',
          'regionLabel',
          'habitatLabel',
          'lat',
          'lng',
          'isSubterranean',
          'harvestCount',
          'description',
          'firstCollectedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'specimenId',
          'domain',
          'affinity',
          'name',
          'latinOrMineralName',
          'familyLabel',
          'lithologyLabel',
          'bedrockPeriod',
          'bedrockAgeMa',
          'regionLabel',
          'habitatLabel',
          'lat',
          'lng',
          'altitudeMeters',
          'isSubterranean',
          'harvestCount',
          'description',
          'firstCollectedAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.specimenId)
        && data.specimenId.size() <= 64
        && data.domain is string && data.domain.size() >= 8 && data.domain.size() <= 16 && data.domain in ['botanique', 'geologie']
        && data.affinity is string && data.affinity.size() >= 4 && data.affinity.size() <= 16 && data.affinity in ['calcaire', 'granit', 'schiste', 'gres', 'alluvions', 'volcanique', 'souterrain']
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.latinOrMineralName is string && data.latinOrMineralName.size() >= 1 && data.latinOrMineralName.size() <= 160
        && data.familyLabel is string && data.familyLabel.size() >= 1 && data.familyLabel.size() <= 120
        && data.lithologyLabel is string && data.lithologyLabel.size() >= 1 && data.lithologyLabel.size() <= 160
        && data.bedrockPeriod is string && data.bedrockPeriod.size() >= 1 && data.bedrockPeriod.size() <= 100
        && data.bedrockAgeMa is string && data.bedrockAgeMa.size() <= 60
        && data.regionLabel is string && data.regionLabel.size() >= 1 && data.regionLabel.size() <= 140
        && data.habitatLabel is string && data.habitatLabel.size() >= 1 && data.habitatLabel.size() <= 160
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('altitudeMeters' in data) || (data.altitudeMeters is number && data.altitudeMeters >= -500 && data.altitudeMeters <= 9000))
        && data.isSubterranean is bool
        && data.harvestCount is number && data.harvestCount >= 1 && data.harvestCount <= 100000
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 1000
        && data.firstCollectedAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: OpenedArchivistChest (synced verbatim with firebase-blueprint.json)
    function isValidOpenedArchivistChest(data) {
      return data.keys().hasAll([
          'ownerId',
          'chestId',
          'archetype',
          'title',
          'placeNote',
          'relicId',
          'relicName',
          'category',
          'regionLabel',
          'lat',
          'lng',
          'isSubterranean',
          'xpAwarded',
          'openedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'chestId',
          'archetype',
          'title',
          'placeNote',
          'relicId',
          'relicName',
          'category',
          'regionLabel',
          'lat',
          'lng',
          'altitudeMeters',
          'isSubterranean',
          'xpAwarded',
          'openedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.chestId)
        && data.archetype is string && data.archetype.size() >= 1 && data.archetype.size() <= 32
        && data.archetype in ['sommet_colline', 'confluence_eaux', 'cul_de_sac_forestier', 'clairiere_sylvestre', 'bouche_souterraine']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.placeNote is string && data.placeNote.size() >= 1 && data.placeNote.size() <= 240
        && isValidId(data.relicId)
        && data.relicId.size() <= 64
        && data.relicName is string && data.relicName.size() >= 1 && data.relicName.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 32
        && data.category in ['histoire', 'geographie', 'ecosysteme', 'etrange', 'legende']
        && data.regionLabel is string && data.regionLabel.size() >= 1 && data.regionLabel.size() <= 140
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('altitudeMeters' in data) || (data.altitudeMeters is number && data.altitudeMeters >= -500 && data.altitudeMeters <= 9000))
        && data.isSubterranean is bool
        && data.xpAwarded is number && data.xpAwarded >= 0 && data.xpAwarded <= 5000
        && data.openedAt is timestamp;
    }

    // Validation Blueprint: ExplorerGeocache (synced verbatim with firebase-blueprint.json)
    function isValidExplorerGeocache(data) {
      return data.keys().hasAll([
          'authorId',
          'authorCallsign',
          'sectorKey',
          'placementMode',
          'lat',
          'lng',
          'isSubterranean',
          'regionLabel',
          'title',
          'riddleHint',
          'giftKind',
          'giftId',
          'giftName',
          'giftDomain',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId',
          'authorCallsign',
          'authorGender',
          'authorAvatarPreset',
          'authorSkinTone',
          'authorHeadgearId',
          'authorOutfitId',
          'sectorKey',
          'placementMode',
          'anchorPoiId',
          'lat',
          'lng',
          'isSubterranean',
          'regionLabel',
          'title',
          'riddleHint',
          'giftKind',
          'giftId',
          'giftName',
          'giftDomain',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.authorId)
        && data.authorId == request.auth.uid
        && data.authorCallsign is string && data.authorCallsign.size() >= 1 && data.authorCallsign.size() <= 60
        && (!('authorGender' in data) || (data.authorGender is string && data.authorGender.size() >= 1 && data.authorGender.size() <= 16 && data.authorGender in ['feminin', 'masculin', 'neutre']))
        && (!('authorAvatarPreset' in data) || (data.authorAvatarPreset is string && data.authorAvatarPreset.size() >= 1 && data.authorAvatarPreset.size() <= 32 && data.authorAvatarPreset in ['cartographe', 'eclaireur', 'archiviste', 'forgeron', 'oracle', 'botaniste']))
        && (!('authorSkinTone' in data) || (data.authorSkinTone is string && data.authorSkinTone.size() >= 1 && data.authorSkinTone.size() <= 32 && data.authorSkinTone in ['clair', 'hale', 'ambre', 'ebene', 'porcelaine']))
        && (!('authorHeadgearId' in data) || isValidHeadgearEnum(data.authorHeadgearId))
        && (!('authorOutfitId' in data) || isValidOutfitEnum(data.authorOutfitId))
        && isValidId(data.sectorKey)
        && data.sectorKey.size() >= 3 && data.sectorKey.size() <= 32
        && data.placementMode is string && data.placementMode.size() >= 8 && data.placementMode.size() <= 16
        && data.placementMode in ['gps_live', 'unlocked_poi']
        && (!('anchorPoiId' in data) || isValidId(data.anchorPoiId))
        && (data.placementMode == 'gps_live' || 'anchorPoiId' in data)
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.isSubterranean is bool
        && data.regionLabel is string && data.regionLabel.size() >= 1 && data.regionLabel.size() <= 140
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
        && data.riddleHint is string && data.riddleHint.size() >= 5 && data.riddleHint.size() <= 320
        && data.giftKind is string && data.giftKind.size() >= 5 && data.giftKind.size() <= 16
        && data.giftKind in ['relic', 'specimen']
        && isValidId(data.giftId)
        && data.giftId.size() <= 64
        && data.giftName is string && data.giftName.size() >= 1 && data.giftName.size() <= 160
        && data.giftDomain is string && data.giftDomain.size() >= 7 && data.giftDomain.size() <= 16
        && data.giftDomain in ['relique', 'botanique', 'geologie']
        && data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: GeocacheLogEntry (synced verbatim with firebase-blueprint.json)
    function isValidGeocacheLogEntry(data) {
      return data.keys().hasAll([
          'cacheId',
          'finderId',
          'finderCallsign',
          'note',
          'visibility',
          'foundAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'cacheId',
          'finderId',
          'finderCallsign',
          'finderGender',
          'finderAvatarPreset',
          'finderSkinTone',
          'finderHeadgearId',
          'finderOutfitId',
          'note',
          'visibility',
          'foundAt',
          'updatedAt'
        ])
        && isValidId(data.cacheId)
        && isValidId(data.finderId)
        && data.finderId == request.auth.uid
        && data.finderCallsign is string && data.finderCallsign.size() >= 1 && data.finderCallsign.size() <= 60
        && (!('finderGender' in data) || (data.finderGender is string && data.finderGender.size() >= 1 && data.finderGender.size() <= 16 && data.finderGender in ['feminin', 'masculin', 'neutre']))
        && (!('finderAvatarPreset' in data) || (data.finderAvatarPreset is string && data.finderAvatarPreset.size() >= 1 && data.finderAvatarPreset.size() <= 32 && data.finderAvatarPreset in ['cartographe', 'eclaireur', 'archiviste', 'forgeron', 'oracle', 'botaniste']))
        && (!('finderSkinTone' in data) || (data.finderSkinTone is string && data.finderSkinTone.size() >= 1 && data.finderSkinTone.size() <= 32 && data.finderSkinTone in ['clair', 'hale', 'ambre', 'ebene', 'porcelaine']))
        && (!('finderHeadgearId' in data) || isValidHeadgearEnum(data.finderHeadgearId))
        && (!('finderOutfitId' in data) || isValidOutfitEnum(data.finderOutfitId))
        && data.note is string && data.note.size() >= 3 && data.note.size() <= 240
        && data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public'
        && data.foundAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: CommunityChallengeEntry (synced verbatim with firebase-blueprint.json)
    function isValidCommunityChallengeEntry(data) {
      return data.keys().hasAll([
          'challengeId',
          'cadence',
          'periodKey',
          'explorerId',
          'explorerCallsign',
          'contributionCount',
          'points',
          'regionLabel',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'challengeId',
          'cadence',
          'periodKey',
          'explorerId',
          'explorerCallsign',
          'explorerGender',
          'explorerAvatarPreset',
          'explorerSkinTone',
          'explorerHeadgearId',
          'explorerOutfitId',
          'explorerFamiliarId',
          'explorerPinnedTrophyId',
          'contributionCount',
          'points',
          'regionLabel',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.challengeId)
        && data.challengeId.size() <= 80
        && data.cadence is string && data.cadence.size() >= 7 && data.cadence.size() <= 16
        && data.cadence in ['quotidien', 'hebdomadaire', 'mensuel']
        && data.periodKey is string && data.periodKey.size() == 7 && data.periodKey.matches('^[0-9]{4}-[0-9]{2}$')
        && isValidId(data.explorerId)
        && data.explorerId == request.auth.uid
        && data.explorerCallsign is string && data.explorerCallsign.size() >= 1 && data.explorerCallsign.size() <= 60
        && (!('explorerGender' in data) || (data.explorerGender is string && data.explorerGender.size() >= 1 && data.explorerGender.size() <= 16 && data.explorerGender in ['feminin', 'masculin', 'neutre']))
        && (!('explorerAvatarPreset' in data) || (data.explorerAvatarPreset is string && data.explorerAvatarPreset.size() >= 1 && data.explorerAvatarPreset.size() <= 32 && data.explorerAvatarPreset in ['cartographe', 'eclaireur', 'archiviste', 'forgeron', 'oracle', 'botaniste']))
        && (!('explorerSkinTone' in data) || (data.explorerSkinTone is string && data.explorerSkinTone.size() >= 1 && data.explorerSkinTone.size() <= 32 && data.explorerSkinTone in ['clair', 'hale', 'ambre', 'ebene', 'porcelaine']))
        && (!('explorerHeadgearId' in data) || isValidHeadgearEnum(data.explorerHeadgearId))
        && (!('explorerOutfitId' in data) || isValidOutfitEnum(data.explorerOutfitId))
        && (!('explorerFamiliarId' in data) || isValidFamiliarEnum(data.explorerFamiliarId))
        && (!('explorerPinnedTrophyId' in data) || isValidPinnedTrophyEnum(data.explorerPinnedTrophyId))
        && data.contributionCount is number && data.contributionCount >= 1 && data.contributionCount <= 10000
        && data.points is number && data.points >= 1 && data.points <= 1000000
        && data.regionLabel is string && data.regionLabel.size() >= 1 && data.regionLabel.size() <= 100
        && data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: PantheonLeaderboardEntry (synced verbatim with firebase-blueprint.json)
    function isValidPantheonLeaderboardEntry(data) {
      return data.keys().hasAll([
          'explorerId',
          'explorerCallsign',
          'regionLabel',
          'pantheonScore',
          'totalXp',
          'diversityScore',
          'rarityScore',
          'discoveriesCount',
          'categoriesCount',
          'strataCount',
          'sourcesCount',
          'secretArchivesCount',
          'officialHeritageCount',
          'liveEventsCount',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'explorerId',
          'explorerCallsign',
          'regionLabel',
          'explorerGender',
          'explorerAvatarPreset',
          'explorerSkinTone',
          'explorerHeadgearId',
          'explorerOutfitId',
          'explorerFamiliarId',
          'explorerPinnedTrophyId',
          'pantheonScore',
          'totalXp',
          'diversityScore',
          'rarityScore',
          'discoveriesCount',
          'categoriesCount',
          'strataCount',
          'sourcesCount',
          'secretArchivesCount',
          'officialHeritageCount',
          'liveEventsCount',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.explorerId)
        && data.explorerId == request.auth.uid
        && data.explorerCallsign is string && data.explorerCallsign.size() >= 1 && data.explorerCallsign.size() <= 60
        && data.regionLabel is string && data.regionLabel.size() >= 1 && data.regionLabel.size() <= 100
        && (!('explorerGender' in data) || (data.explorerGender is string && data.explorerGender.size() >= 1 && data.explorerGender.size() <= 16 && data.explorerGender in ['feminin', 'masculin', 'neutre']))
        && (!('explorerAvatarPreset' in data) || (data.explorerAvatarPreset is string && data.explorerAvatarPreset.size() >= 1 && data.explorerAvatarPreset.size() <= 32 && data.explorerAvatarPreset in ['cartographe', 'eclaireur', 'archiviste', 'forgeron', 'oracle', 'botaniste']))
        && (!('explorerSkinTone' in data) || (data.explorerSkinTone is string && data.explorerSkinTone.size() >= 1 && data.explorerSkinTone.size() <= 32 && data.explorerSkinTone in ['clair', 'hale', 'ambre', 'ebene', 'porcelaine']))
        && (!('explorerHeadgearId' in data) || isValidHeadgearEnum(data.explorerHeadgearId))
        && (!('explorerOutfitId' in data) || isValidOutfitEnum(data.explorerOutfitId))
        && (!('explorerFamiliarId' in data) || isValidFamiliarEnum(data.explorerFamiliarId))
        && (!('explorerPinnedTrophyId' in data) || isValidPinnedTrophyEnum(data.explorerPinnedTrophyId))
        && data.pantheonScore is number && data.pantheonScore >= 0 && data.pantheonScore <= 50000000
        && data.totalXp is number && data.totalXp >= 0 && data.totalXp <= 10000000
        && data.diversityScore is number && data.diversityScore >= 0 && data.diversityScore <= 1000000
        && data.rarityScore is number && data.rarityScore >= 0 && data.rarityScore <= 5000000
        && data.discoveriesCount is number && data.discoveriesCount >= 0 && data.discoveriesCount <= 100000
        && data.categoriesCount is number && data.categoriesCount >= 0 && data.categoriesCount <= 5
        && data.strataCount is number && data.strataCount >= 0 && data.strataCount <= 7
        && data.sourcesCount is number && data.sourcesCount >= 0 && data.sourcesCount <= 50
        && data.secretArchivesCount is number && data.secretArchivesCount >= 0 && data.secretArchivesCount <= 10000
        && data.officialHeritageCount is number && data.officialHeritageCount >= 0 && data.officialHeritageCount <= 100000
        && data.liveEventsCount is number && data.liveEventsCount >= 0 && data.liveEventsCount <= 100000
        && data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasExistingExplorerParent(userId) {
      return exists(/databases/$(database)/documents/explorers/$(userId))
        && get(/databases/$(database)/documents/explorers/$(userId)).data.ownerId == request.auth.uid;
    }

    function hasValidExplorerParent(userId) {
      return hasExistingExplorerParent(userId) || (
        existsAfter(/databases/$(database)/documents/explorers/$(userId))
        && getAfter(/databases/$(database)/documents/explorers/$(userId)).data.ownerId == request.auth.uid
      );
    }

    function hasUnlockedPoi(userId, poiId) {
      return (
        exists(/databases/$(database)/documents/explorers/$(userId)/discoveries/$(poiId))
        && get(/databases/$(database)/documents/explorers/$(userId)/discoveries/$(poiId)).data.ownerId == request.auth.uid
      );
    }

    function hasOwnedSpecimen(userId, specimenId) {
      return (
        exists(/databases/$(database)/documents/explorers/$(userId)/specimens/$(specimenId))
        && get(/databases/$(database)/documents/explorers/$(userId)/specimens/$(specimenId)).data.ownerId == request.auth.uid
      );
    }

    function hasExistingPublicGeocache(cacheId) {
      return (
        exists(/databases/$(database)/documents/geocaches/$(cacheId))
        && get(/databases/$(database)/documents/geocaches/$(cacheId)).data.visibility == 'public'
      );
    }

    // Master Resource: Explorer Profile
    match /explorers/{userId} {
      allow get: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if false;

      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidExplorerProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidExplorerProfile(incoming())
        && isValidId(userId)
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Award XP, increment discoveries/walked distance, complete missions/contracts/narratives/challenges/liveEvents, or sync cosmetics & pinned trophy
          (
            incoming().totalXp >= existing().totalXp
            && incoming().discoveriesCount >= existing().discoveriesCount
            && (!('walkedMeters' in existing()) || ('walkedMeters' in incoming() && incoming().walkedMeters >= existing().walkedMeters))
            && (!('nightFeatsCount' in existing()) || ('nightFeatsCount' in incoming() && incoming().nightFeatsCount >= existing().nightFeatsCount))
            && (!('stormFeatsCount' in existing()) || ('stormFeatsCount' in incoming() && incoming().stormFeatsCount >= existing().stormFeatsCount))
            && (!('completedContractsCount' in existing()) || ('completedContractsCount' in incoming() && incoming().completedContractsCount >= existing().completedContractsCount))
            && (!('solvedRiddlesCount' in existing()) || ('solvedRiddlesCount' in incoming() && incoming().solvedRiddlesCount >= existing().solvedRiddlesCount))
            && (!('completedHuntsCount' in existing()) || ('completedHuntsCount' in incoming() && incoming().completedHuntsCount >= existing().completedHuntsCount))
            && (!('claimedAlmanacCount' in existing()) || ('claimedAlmanacCount' in incoming() && incoming().claimedAlmanacCount >= existing().claimedAlmanacCount))
            && (!('completedNarrativesCount' in existing()) || ('completedNarrativesCount' in incoming() && incoming().completedNarrativesCount >= existing().completedNarrativesCount))
            && (!('claimedCommunityChallengesCount' in existing()) || ('claimedCommunityChallengesCount' in incoming() && incoming().claimedCommunityChallengesCount >= existing().claimedCommunityChallengesCount))
            && (!('claimedLiveEventsCount' in existing()) || ('claimedLiveEventsCount' in incoming() && incoming().claimedLiveEventsCount >= existing().claimedLiveEventsCount))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'totalXp',
              'xpHistoire',
              'xpGeographie',
              'xpEcosysteme',
              'xpEtrange',
              'xpLegende',
              'gender',
              'avatarPreset',
              'skinTone',
              'headgearId',
              'outfitId',
              'toolId',
              'packId',
              'familiarId',
              'pinnedTrophyId',
              'walkedMeters',
              'nightFeatsCount',
              'stormFeatsCount',
              'completedContractsCount',
              'solvedRiddlesCount',
              'completedHuntsCount',
              'claimedAlmanacCount',
              'completedNarrativesCount',
              'claimedCommunityChallengesCount',
              'claimedLiveEventsCount',
              'discoveriesCount',
              'completedMissions',
              'updatedAt'
            ])
          )
          ||
          // Action 2: Rename explorer callsign, pin trophy, or customize 16-bit gender, avatar, familiar & cosmetic equipment
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'gender',
              'avatarPreset',
              'skinTone',
              'headgearId',
              'outfitId',
              'toolId',
              'packId',
              'familiarId',
              'pinnedTrophyId',
              'updatedAt'
            ])
          )
          ||
          // Action 3: Complete Character Reset back to Level 1 / zero progression
          (
            incoming().totalXp == 0
            && incoming().xpHistoire == 0
            && incoming().xpGeographie == 0
            && incoming().xpEcosysteme == 0
            && incoming().xpEtrange == 0
            && (!('xpLegende' in incoming()) || incoming().xpLegende == 0)
            && (!('walkedMeters' in incoming()) || incoming().walkedMeters == 0)
            && (!('nightFeatsCount' in incoming()) || incoming().nightFeatsCount == 0)
            && (!('stormFeatsCount' in incoming()) || incoming().stormFeatsCount == 0)
            && (!('completedContractsCount' in incoming()) || incoming().completedContractsCount == 0)
            && (!('solvedRiddlesCount' in incoming()) || incoming().solvedRiddlesCount == 0)
            && (!('completedHuntsCount' in incoming()) || incoming().completedHuntsCount == 0)
            && (!('claimedAlmanacCount' in incoming()) || incoming().claimedAlmanacCount == 0)
            && (!('completedNarrativesCount' in incoming()) || incoming().completedNarrativesCount == 0)
            && (!('claimedCommunityChallengesCount' in incoming()) || incoming().claimedCommunityChallengesCount == 0)
            && (!('claimedLiveEventsCount' in incoming()) || incoming().claimedLiveEventsCount == 0)
            && (!('pinnedTrophyId' in incoming()) || incoming().pinnedTrophyId == '')
            && incoming().discoveriesCount == 0
            && incoming().completedMissions.size() == 0
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'totalXp',
              'xpHistoire',
              'xpGeographie',
              'xpEcosysteme',
              'xpEtrange',
              'xpLegende',
              'gender',
              'avatarPreset',
              'skinTone',
              'headgearId',
              'outfitId',
              'toolId',
              'packId',
              'familiarId',
              'pinnedTrophyId',
              'walkedMeters',
              'nightFeatsCount',
              'stormFeatsCount',
              'completedContractsCount',
              'solvedRiddlesCount',
              'completedHuntsCount',
              'claimedAlmanacCount',
              'completedNarrativesCount',
              'claimedCommunityChallengesCount',
              'claimedLiveEventsCount',
              'discoveriesCount',
              'completedMissions',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;

      // Subcollection: Carnet d'Exploration Discoveries
      match /discoveries/{discoveryId} {
        allow get: if isVerified()
          && isValidId(userId)
          && isValidId(discoveryId)
          && request.auth.uid == userId
          && (resource == null || existing().ownerId == request.auth.uid)
          && hasValidExplorerParent(userId);

        // Pillar 8: Secure List Enforcer without get()/exists() O(n) reads
        allow list: if isVerified()
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(discoveryId)
          && request.auth.uid == userId
          && isValidJournalDiscovery(incoming())
          && incoming().poiId == discoveryId
          && incoming().discoveredAt == request.time
          && incoming().updatedAt == request.time
          && hasValidExplorerParent(userId);

        allow update: if isVerified()
          && isValidJournalDiscovery(incoming())
          && isValidId(userId)
          && isValidId(discoveryId)
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().poiId == existing().poiId
          && incoming().discoveredAt == existing().discoveredAt
          && incoming().updatedAt == request.time
          && hasValidExplorerParent(userId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'personalNote',
              'photoCount',
              'updatedAt'
            ])
          );

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(discoveryId)
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid
          && hasExistingExplorerParent(userId);
      }

      // Subcollection: Herbarium & Lithothèque Specimens
      match /specimens/{specimenId} {
        allow get: if isVerified()
          && isValidId(userId)
          && isValidId(specimenId)
          && request.auth.uid == userId
          && (resource == null || existing().ownerId == request.auth.uid)
          && hasValidExplorerParent(userId);

        // Pillar 8: Cost-Optimized Query Enforcer without get()/exists() O(n) reads
        allow list: if isVerified()
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(specimenId)
          && request.auth.uid == userId
          && isValidExplorerSpecimen(incoming())
          && incoming().specimenId == specimenId
          && incoming().firstCollectedAt == request.time
          && incoming().updatedAt == request.time
          && hasValidExplorerParent(userId);

        allow update: if isVerified()
          && isValidExplorerSpecimen(incoming())
          && isValidId(userId)
          && isValidId(specimenId)
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().specimenId == existing().specimenId
          && incoming().domain == existing().domain
          && incoming().firstCollectedAt == existing().firstCollectedAt
          && incoming().harvestCount >= existing().harvestCount
          && incoming().updatedAt == request.time
          && hasValidExplorerParent(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'affinity',
            'lithologyLabel',
            'bedrockPeriod',
            'bedrockAgeMa',
            'regionLabel',
            'habitatLabel',
            'lat',
            'lng',
            'altitudeMeters',
            'isSubterranean',
            'harvestCount',
            'description',
            'updatedAt'
          ]);

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(specimenId)
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid
          && hasExistingExplorerParent(userId);
      }

      // Subcollection: Opened Deterministic Archivist Chests
      match /archivistChests/{chestId} {
        allow get: if isVerified()
          && isValidId(userId)
          && isValidId(chestId)
          && request.auth.uid == userId
          && (resource == null || existing().ownerId == request.auth.uid)
          && hasValidExplorerParent(userId);

        // Pillar 8: Cost-Optimized Query Enforcer without get()/exists() O(n) reads
        allow list: if isVerified()
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(chestId)
          && request.auth.uid == userId
          && isValidOpenedArchivistChest(incoming())
          && incoming().chestId == chestId
          && incoming().openedAt == request.time
          && hasValidExplorerParent(userId);

        // Opened Archivist Chests are immutable once unlocked (terminal state)
        allow update: if false;

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(chestId)
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid
          && hasExistingExplorerParent(userId);
      }
    }

    // Asynchronous Field Cairns left by verified explorers on unlocked POIs
    match /cairns/{cairnId} {
      allow get: if isVerified()
        && isValidId(cairnId)
        && (resource == null || existing().visibility == 'public');

      allow list: if isVerified()
        && existing().visibility == 'public';

      allow create: if isVerified()
        && isValidId(cairnId)
        && isValidExplorerCairn(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidExplorerParent(request.auth.uid)
        && hasUnlockedPoi(request.auth.uid, incoming().poiId);

      allow update: if isVerified()
        && isValidExplorerCairn(incoming())
        && isValidId(cairnId)
        && existing().authorId == request.auth.uid
        && incoming().authorId == existing().authorId
        && incoming().poiId == existing().poiId
        && incoming().poiName == existing().poiName
        && incoming().visibility == existing().visibility
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && hasUnlockedPoi(request.auth.uid, existing().poiId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorCallsign',
          'authorGender',
          'authorAvatarPreset',
          'authorSkinTone',
          'authorHeadgearId',
          'authorOutfitId',
          'tag',
          'message',
          'updatedAt'
        ]);

      allow delete: if isVerified()
        && isValidId(cairnId)
        && existing().authorId == request.auth.uid;
    }

    // Shared 16-bit Explorer Geocaches (Time Capsules buried at physical GPS or unlocked POIs)
    match /geocaches/{cacheId} {
      allow get: if isVerified()
        && isValidId(cacheId)
        && (resource == null || existing().visibility == 'public');

      // Pillar 8: Cost-Optimized Query Enforcer without get()/exists() inside list
      allow list: if isVerified()
        && existing().visibility == 'public';

      allow create: if isVerified()
        && isValidId(cacheId)
        && isValidExplorerGeocache(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidExplorerParent(request.auth.uid)
        && (
          incoming().placementMode == 'gps_live'
          || (
            incoming().placementMode == 'unlocked_poi'
            && 'anchorPoiId' in incoming()
            && hasUnlockedPoi(request.auth.uid, incoming().anchorPoiId)
          )
        )
        && (
          incoming().giftKind == 'relic'
          || hasOwnedSpecimen(request.auth.uid, incoming().giftId)
        );

      allow update: if isVerified()
        && isValidExplorerGeocache(incoming())
        && isValidId(cacheId)
        && existing().authorId == request.auth.uid
        && incoming().authorId == existing().authorId
        && incoming().sectorKey == existing().sectorKey
        && incoming().placementMode == existing().placementMode
        && (
          (!('anchorPoiId' in existing()) && !('anchorPoiId' in incoming()))
          || ('anchorPoiId' in existing() && 'anchorPoiId' in incoming() && incoming().anchorPoiId == existing().anchorPoiId)
        )
        && incoming().lat == existing().lat
        && incoming().lng == existing().lng
        && incoming().isSubterranean == existing().isSubterranean
        && incoming().giftKind == existing().giftKind
        && incoming().giftId == existing().giftId
        && incoming().giftName == existing().giftName
        && incoming().giftDomain == existing().giftDomain
        && incoming().visibility == existing().visibility
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && hasExistingExplorerParent(request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorCallsign',
          'authorGender',
          'authorAvatarPreset',
          'authorSkinTone',
          'authorHeadgearId',
          'authorOutfitId',
          'title',
          'riddleHint',
          'updatedAt'
        ]);

      allow delete: if isVerified()
        && isValidId(cacheId)
        && existing().authorId == request.auth.uid
        && hasExistingExplorerParent(request.auth.uid);

      // Subcollection: Discoverer Logbook Signatures (Pillar 1 Master Gate)
      match /logs/{finderId} {
        allow get: if isVerified()
          && isValidId(cacheId)
          && isValidId(finderId)
          && (resource == null || existing().visibility == 'public')
          && hasExistingPublicGeocache(cacheId);

        // Pillar 8: Cost-Optimized Query Enforcer without get()/exists() inside list
        allow list: if isVerified()
          && existing().visibility == 'public'
          && existing().cacheId == cacheId;

        allow create: if isVerified()
          && isValidId(cacheId)
          && isValidId(finderId)
          && request.auth.uid == finderId
          && isValidGeocacheLogEntry(incoming())
          && incoming().cacheId == cacheId
          && incoming().foundAt == request.time
          && incoming().updatedAt == request.time
          && hasValidExplorerParent(request.auth.uid)
          && hasExistingPublicGeocache(cacheId);

        allow update: if isVerified()
          && isValidGeocacheLogEntry(incoming())
          && isValidId(cacheId)
          && isValidId(finderId)
          && request.auth.uid == finderId
          && existing().finderId == request.auth.uid
          && incoming().finderId == existing().finderId
          && incoming().cacheId == existing().cacheId
          && incoming().visibility == existing().visibility
          && incoming().foundAt == existing().foundAt
          && incoming().updatedAt == request.time
          && hasExistingExplorerParent(request.auth.uid)
          && hasExistingPublicGeocache(cacheId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'finderCallsign',
            'finderGender',
            'finderAvatarPreset',
            'finderSkinTone',
            'finderHeadgearId',
            'finderOutfitId',
            'note',
            'updatedAt'
          ]);

        allow delete: if isVerified()
          && isValidId(cacheId)
          && isValidId(finderId)
          && request.auth.uid == finderId
          && existing().finderId == request.auth.uid
          && hasExistingExplorerParent(request.auth.uid);
      }
    }

    // Shared Community Challenge Contributions & Leaderboards (/challengeEntries/{entryId})
    match /challengeEntries/{entryId} {
      allow get: if isVerified()
        && isValidId(entryId)
        && (resource == null || existing().visibility == 'public');

      // Pillar 8: Cost-Optimized Query Enforcer without get()/exists() inside list
      allow list: if isVerified()
        && existing().visibility == 'public';

      allow create: if isVerified()
        && isValidId(entryId)
        && isValidCommunityChallengeEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidExplorerParent(request.auth.uid);

      allow update: if isVerified()
        && isValidCommunityChallengeEntry(incoming())
        && isValidId(entryId)
        && existing().explorerId == request.auth.uid
        && incoming().explorerId == existing().explorerId
        && incoming().challengeId == existing().challengeId
        && incoming().cadence == existing().cadence
        && incoming().periodKey == existing().periodKey
        && incoming().visibility == existing().visibility
        && incoming().createdAt == existing().createdAt
        && incoming().contributionCount >= existing().contributionCount
        && incoming().points >= existing().points
        && incoming().updatedAt == request.time
        && hasExistingExplorerParent(request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'explorerCallsign',
          'explorerGender',
          'explorerAvatarPreset',
          'explorerSkinTone',
          'explorerHeadgearId',
          'explorerOutfitId',
          'explorerFamiliarId',
          'explorerPinnedTrophyId',
          'contributionCount',
          'points',
          'regionLabel',
          'updatedAt'
        ]);

      allow delete: if isVerified()
        && isValidId(entryId)
        && existing().explorerId == request.auth.uid
        && hasExistingExplorerParent(request.auth.uid);
    }

    // Shared Global Multiplayer Pantheon Leaderboard (/pantheonEntries/{explorerId})
    match /pantheonEntries/{explorerId} {
      allow get: if isVerified()
        && isValidId(explorerId)
        && (resource == null || existing().visibility == 'public');

      // Pillar 8: Cost-Optimized Query Enforcer without get()/exists() inside list
      allow list: if isVerified()
        && existing().visibility == 'public';

      allow create: if isVerified()
        && isValidId(explorerId)
        && request.auth.uid == explorerId
        && isValidPantheonLeaderboardEntry(incoming())
        && incoming().explorerId == explorerId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasValidExplorerParent(request.auth.uid);

      allow update: if isVerified()
        && isValidPantheonLeaderboardEntry(incoming())
        && isValidId(explorerId)
        && request.auth.uid == explorerId
        && existing().explorerId == request.auth.uid
        && incoming().explorerId == existing().explorerId
        && incoming().visibility == existing().visibility
        && incoming().createdAt == existing().createdAt
        && incoming().pantheonScore >= existing().pantheonScore
        && incoming().totalXp >= existing().totalXp
        && incoming().discoveriesCount >= existing().discoveriesCount
        && incoming().updatedAt == request.time
        && hasExistingExplorerParent(request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'explorerCallsign',
          'regionLabel',
          'explorerGender',
          'explorerAvatarPreset',
          'explorerSkinTone',
          'explorerHeadgearId',
          'explorerOutfitId',
          'explorerFamiliarId',
          'explorerPinnedTrophyId',
          'pantheonScore',
          'totalXp',
          'diversityScore',
          'rarityScore',
          'discoveriesCount',
          'categoriesCount',
          'strataCount',
          'sourcesCount',
          'secretArchivesCount',
          'officialHeritageCount',
          'liveEventsCount',
          'updatedAt'
        ]);

      allow delete: if isVerified()
        && isValidId(explorerId)
        && request.auth.uid == explorerId
        && existing().explorerId == request.auth.uid
        && hasExistingExplorerParent(request.auth.uid);
    }
  }
}
